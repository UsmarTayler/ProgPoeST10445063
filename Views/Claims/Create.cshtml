@model CMCS.Mvc.Models.Claim
@{
    ViewData["Title"] = "Submit Claim";
}

<h2 class="mb-4">Submit Claim</h2>

<form asp-action="Create" enctype="multipart/form-data" method="post">
    <div class="row">

        <!-- Lecturer -->
        <div class="col-md-6 mb-3">
            <label asp-for="LecturerId"></label>
            <select asp-for="LecturerId" class="form-select" asp-items="ViewBag.Lecturers">
                <option value="">Select Lecturer</option>
            </select>
            <span asp-validation-for="LecturerId" class="text-danger"></span>
        </div>

        <!-- Month -->
        <div class="col-md-6 mb-3">
            <label asp-for="Month"></label>
            <select asp-for="Month" class="form-select" asp-items="ViewBag.Months"></select>
            <span asp-validation-for="Month" class="text-danger"></span>
        </div>

        <!-- Hours -->
        <div class="col-md-6 mb-3">
            <label asp-for="HoursWorked"></label>
            <input asp-for="HoursWorked" id="HoursWorked" class="form-control" />
            <span asp-validation-for="HoursWorked" class="text-danger"></span>
        </div>

        <!-- Rate -->
        <div class="col-md-6 mb-3">
            <label>Hourly Rate</label>
            <input asp-for="HourlyRate" id="HourlyRate" class="form-control" readonly />
            <small class="text-muted">(Auto-filled from lecturer profile)</small>
            <span asp-validation-for="HourlyRate" class="text-danger"></span>
        </div>

        <!-- Total -->
        <div class="col-md-6 mb-3">
            <label>Total Amount</label>
            <input id="TotalAmount" class="form-control" readonly />
        </div>

        <!-- Description -->
        <div class="col-md-12 mb-3">
            <label asp-for="Description"></label>
            <textarea asp-for="Description" class="form-control"></textarea>
        </div>

        <!-- Uploads -->
        <div class="col-md-6 mb-3">
            <label>Upload Document 1</label>
            <input type="file" name="upload1" class="form-control" />
        </div>

        <div class="col-md-6 mb-3">
            <label>Upload Document 2</label>
            <input type="file" name="upload2" class="form-control" />
        </div>

    </div>

    <button class="btn btn-primary mt-3">Submit Claim</button>
</form>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        function updateTotal() {
            let hours = parseFloat(document.getElementById("HoursWorked").value) || 0;
            let rate = parseFloat(document.getElementById("HourlyRate").value) || 0;

            document.getElementById("TotalAmount").value = (hours * rate).toFixed(2);
        }

        document.getElementById("HoursWorked").addEventListener("input", updateTotal);
        document.getElementById("HourlyRate").addEventListener("input", updateTotal);
    </script>

    <script>
        document.getElementById("LecturerId").addEventListener("change", function () {
            var lecturerId = this.value;
            if (!lecturerId) return;

            fetch('/Claims/GetRate?lecturerId=' + lecturerId)
                .then(response => response.json())
                .then(data => {
                    document.getElementById("HourlyRate").value = data.rate;
                    updateTotal();
                });
        });
    </script>
}

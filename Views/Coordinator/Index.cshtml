@model IEnumerable<CMCS.Mvc.Models.Claim>

@{
    ViewData["Title"] = "Coordinator Dashboard";
}

<h2>Pending Claims – Coordinator Review</h2>

<table class="table table-striped mt-3">
    <thead>
        <tr>
            <th>Lecturer</th>
            <th>Month</th>
            <th>Hours</th>
            <th>Total Amount</th>
            <th>Description</th>
            <th></th>
        </tr>
    </thead>

    <tbody>
        @foreach (var c in Model)
        {
            <tr>
                <td>@c.Lecturer?.FullName</td>
                <td>@c.Month</td>
                <td>@c.HoursWorked</td>
                <td>@(c.HoursWorked * c.HourlyRate)</td>
                <td>@c.Description</td>
                <td>
                    <a asp-action="Review" asp-route-id="@c.ClaimId" class="btn btn-sm btn-primary">Review</a>
                </td>
            </tr>
        }
    </tbody>
</table>

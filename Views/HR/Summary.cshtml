@model IEnumerable<CMCS.Mvc.Models.HrSummaryVM>

@{
    ViewData["Title"] = "Monthly Summary";
}

<h2>Monthly Claim Summary</h2>
<hr />

<form method="get" class="row mb-3">
    <div class="col-md-3">
        <label>Select Month</label>
        <select name="month" class="form-select">
            @for (int m = 1; m <= 12; m++)
            {
                <option value="@m"
                        selected="@(ViewBag.Month == m)">
                    @System.Globalization.CultureInfo.CurrentCulture.DateTimeFormat.GetMonthName(m)
                </option>
            }
        </select>
    </div>

    <div class="col-md-3">
        <label>Select Year</label>
        <input name="year" class="form-control" value="@ViewBag.Year" />
    </div>

    <div class="col-md-3 d-flex align-items-end">
        <button class="btn btn-primary">Load Summary</button>
    </div>
</form>

<table class="table table-bordered table-striped">
    <thead class="table-dark">
        <tr>
            <th>Lecturer</th>
            <th>Total Hours</th>
            <th>Total Amount (R)</th>
            <th>Claims Count</th>
        </tr>
    </thead>
    <tbody>
        @foreach (var item in Model)
        {
            <tr>
                <td>@item.LecturerName</td>
                <td>@item.TotalHours</td>
                <td>@item.TotalAmount.ToString("C")</td>
                <td>@item.ClaimsCount</td>
            </tr>
        }
    </tbody>
</table>

@if (!Model.Any())
{
    <p>No approved claims found for this month.</p>
}
